# Référence des variables de l'infra. Dans la pile, infra/.env est un lien vers le .env
# de main (make init) : c'est lui qu'il faut remplir. Le .env n'est JAMAIS commité.
# IP sur laquelle les ports sont publiés : 127.0.0.1 en dev, 192.168.40.1 sur le serveur
BIND_IP=127.0.0.1

# Comptes MQTT (scripts/mqtt-users.sh). sentinel_iot = compte de l'ESP8266 (mdp fourni par Baptiste)
MQTT_ESP_PASSWORD=change-me
MQTT_BACKEND_PASSWORD=change-me
# vision = IA caméra (human-detection-ia), detection = service de détection (backend-iot-alerts)
MQTT_VISION_PASSWORD=change-me
MQTT_DETECTION_PASSWORD=change-me
# DEV uniquement : laisser vide en prod (le compte simulator n'est alors pas créé)
MQTT_SIMULATOR_PASSWORD=
